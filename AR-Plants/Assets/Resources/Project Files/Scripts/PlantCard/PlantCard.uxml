<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:ScrollView name="content" class="content" style="font-size: 35px;">
        <ui:VisualElement name="plant-card" class="plant-card" style="font-size: 28px; height: 280px;">
            <ui:VisualElement name="card-header" class="card-header">
                <ui:Label text="Desert Beauty" class="card-title" style="font-size: 35px;" />
            </ui:VisualElement>
            <ui:VisualElement name="card-content" class="card-content">
                <ui:VisualElement name="info-row" class="info-row" style="font-size: 40px;">
                    <ui:Label text="Species:" class="info-label" style="font-size: 20px;" />
                    <ui:Label text="Echinocactus grusonii" class="info-value" style="font-size: 20px;" />
                </ui:VisualElement>
                <ui:VisualElement name="info-row" class="info-row">
                    <ui:Label text="Region:" class="info-label" style="font-size: 20px;" />
                    <ui:Label text="Living Room Window" class="info-value" style="font-size: 20px;" />
                </ui:VisualElement>
                <ui:Label text="*A stunning golden barrel cactus with bright yellow spines. Thrives in bright sunlight and requires minimal watering." class="info-note" style="font-size: 18px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>