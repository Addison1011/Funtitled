<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="plant-card" class="plant-card" style="font-size: 28px; height: auto; align-self: auto; flex-direction: column; align-items: stretch; width: auto; align-content: flex-start;">
        <ui:VisualElement name="name" class="card-header" style="align-self: auto;">
            <ui:Label text="Desert Beauty" name="PlantName" class="card-title" style="font-size: 35px; opacity: 1; align-self: auto;">
                <ui:Button name="PlantDescriptionButton" icon-image="project://database/Assets/Samples/XR%20Interaction%20Toolkit/3.1.2/XR%20Device%20Simulator/XRInteractionSimulator/UI/Translate/TranslateRight@2x.png?fileID=2800000&amp;guid=eb5a85b675ed34acf9efd6d574df4ceb&amp;type=3#TranslateRight@2x" selectable="false" style="width: 76px; align-self: flex-end; background-image: none; background-color: rgba(162, 242, 189, 0.71); height: 62px; cursor: initial; -unity-background-image-tint-color: rgba(0, 234, 255, 0); border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0);" />
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="card-content" class="card-content">
            <ui:VisualElement name="species" class="info-row" style="font-size: 40px;">
                <ui:Label text="Species:" class="info-label" style="font-size: 20px;" />
                <ui:Label text="Echinocactus grusonii" name="ScientificName" class="info-value" style="font-size: 20px;" />
            </ui:VisualElement>
            <ui:VisualElement name="info-row" class="info-row" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
