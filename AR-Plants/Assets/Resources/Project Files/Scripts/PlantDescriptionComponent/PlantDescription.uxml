<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/Project%20Files/Scripts/PlantDescriptionComponent/PlantDescriptionStyles.uss?fileID=7433441132597879392&amp;guid=f37c3bc3574c61e43be4ca094aff3bfd&amp;type=3#PlantDescriptionStyles" />
    <ui:VisualElement name="Plant" class="plant-description" style="visibility: visible; overflow: hidden; width: 100%; height: 100%; margin-bottom: 0; margin-top: 0;">
        <ui:VisualElement name="HeaderSection" class="header-section">
            <ui:VisualElement name="HeaderImage" class="header-image" />
            <ui:Button name="BackButton" class="back-button">
                <ui:Label text="&lt;" class="back-icon" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="ContentContainer" class="content-container">
            <ui:VisualElement name="TitleSection" class="title-section">
                <ui:VisualElement name="TitleGroup" class="title-group">
                    <ui:Label text="Golden Barrel Cactus" name="CommonName" class="common-name" />
                    <ui:Label text="Kroenleinia grusonii" name="ScientificName" class="scientific-name" />
                </ui:VisualElement>
                <ui:Button name="ARButton" class="ar-button">
                    <ui:VisualElement name="CameraIcon" class="camera-icon" />
                    <ui:Label text="View in AR" class="ar-label" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Label name="PlantDescription" text="Kroenleinia grusonii, popularly known as the golden barrel cactus, golden ball, &quot;mother-in-law&apos;s cushion&quot; or &quot;mother-in-law&apos;s chair&quot;, is a species of barrel cactus which is endemic to east-central Mexico." class="description" />
            <ui:VisualElement name="MapSection" class="map-section">
                <ui:VisualElement name="MapImage" class="map-image" />
                <ui:VisualElement name="LocationBadge" class="location-badge">
                    <ui:VisualElement name="PinIcon" class="pin-icon" />
                    <ui:Label text="Mexico" class="location-text" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
