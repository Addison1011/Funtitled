            <ui:VisualElement name="logo" style="flex-grow: 1; background-image: resource(&quot;Project Files/icons/logo&quot;); background-position-x: left 0; background-size: 100% 100%; background-position-y: top 0; width: 100%; height: 100%; flex-direction: row; align-items: auto; align-content: center;"/>
