<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="MainMenu.uss" />
    
    <ui:VisualElement name="root" class="root">
        
        <ui:VisualElement name="header" class="header">
            <ui:Label text="Plantify" class="app-title" />
            <ui:Button name="settings-button" class="settings-button">
                <ui:Label text="⚙" class="settings-icon" />
            </ui:Button>
        </ui:VisualElement>
        
    
        <ui:ScrollView name="content" class="content">
         
            <ui:VisualElement name="plant-card" class="plant-card">
                <ui:VisualElement name="card-header" class="card-header">
                    <ui:Label text="Desert Beauty" class="card-title" />
                    <ui:Button name="menu-button" class="menu-button">
                        <ui:Label text="⋯" class="menu-icon" />
                    </ui:Button>
                </ui:VisualElement>
                
                <ui:VisualElement name="card-content" class="card-content">
                    <ui:VisualElement name="info-row" class="info-row">
                        <ui:Label text="Species:" class="info-label" />
                        <ui:Label text="Echinocactus grusonii" class="info-value" />
                    </ui:VisualElement>
                    
                    <ui:VisualElement name="info-row" class="info-row">
                        <ui:Label text="Region:" class="info-label" />
                        <ui:Label text="Living Room Window" class="info-value" />
                    </ui:VisualElement>
                    
                    <ui:Label text="*A stunning golden barrel cactus with bright yellow spines. Thrives in bright sunlight and requires minimal watering." class="info-note" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>