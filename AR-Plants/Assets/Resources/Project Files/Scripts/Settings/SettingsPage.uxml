<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/Project%20Files/Scripts/MainMenuComponent/MainMenu.uss?fileID=7433441132597879392&amp;guid=03c63967f6e3b1b4499075883a01a6e5&amp;type=3#MainMenu" />
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="header" class="header" style="height: 165px;">
            <ui:Label text="Plantify" class="app-title" style="font-size: 54px;" />
        </ui:VisualElement>
        <ui:VisualElement name="content" style="flex-grow: 1; padding-left: 15px; padding-right: 15px;">
            <ui:Toggle label="Sound" name="sound-toggle" style="font-size: 30px; margin-bottom: 15px;" />
            <ui:VisualElement style="flex-grow: 1; height: 123px; width: 571px;">
                <ui:Label text="Sample Text" name="slider-title" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(0, 0, 0, 0); font-size: 30px;" />
                <ui:SliderInt label="50" value="42" high-value="100" name="slider-number" style="font-size: 30px; -unity-font-style: normal; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="footer" class="header" style="height: 165px;">
            <ui:Button text="Don&apos;t Save" name="cancel-button" style="align-self: auto; align-items: auto; color: rgb(0, 0, 0); background-color: rgb(255, 255, 255); flex-shrink: 0; font-size: 30px;" />
            <ui:Button text="Save Changes" name="save-button" style="align-self: auto; align-items: auto; color: rgb(0, 0, 0); background-color: rgb(255, 255, 255); flex-shrink: 0; font-size: 30px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
